{
  "name": "authforge-exress-thesis-claudegenerated",
  "version": "1.0.0",
  "description": "Production-ready Express.js authentication microservice with TypeScript and MongoDB",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "dependencies": {
    "bcryptjs": "*",
    "cookie-parser": "*",
    "cors": "*",
    "dotenv": "*",
    "express": "*",
    "express-rate-limit": "*",
    "helmet": "*",
    "joi": "*",
    "jsonwebtoken": "*",
    "mongoose": "*",
    "morgan": "*",
    "uuid": "*"
  },
  "devDependencies": {
    "@types/bcryptjs": "*",
    "@types/cookie-parser": "*",
    "@types/cors": "*",
    "@types/express": "*",
    "@types/jsonwebtoken": "*",
    "@types/morgan": "*",
    "@types/node": "*",
    "@types/uuid": "*",
    "ts-node-dev": "*",
    "typescript": "*"
  },
  "keywords": ["express", "typescript", "mongodb", "authentication", "jwt", "microservice"],
  "author": "",
  "license": "MIT"
}
